<%
  // O controller envia o lote que está sendo alterado como "lotes" (ou "lote")
  const bruto = locals.lotes || locals.lote || {};
  const lote = Array.isArray(bruto) ? {} : bruto;
  const editando = lote.id_lote !== undefined && lote.id_lote !== null && lote.id_lote !== '';

  // validade em dd/mm/aaaa: validade_br vem do select; se não vier, converte data_validade
  const validadeBruta = lote.validade_br || lote.data_validade;
  let validadeInput = '';
  if (validadeBruta) {
    if (typeof validadeBruta === 'string' && /^\d{2}\/\d{2}\/\d{4}$/.test(validadeBruta)) {
      validadeInput = validadeBruta;
    } else if (typeof validadeBruta === 'string' && /^\d{4}-\d{2}-\d{2}/.test(validadeBruta)) {
      const [a, m, d] = validadeBruta.slice(0, 10).split('-');
      validadeInput = `${d}/${m}/${a}`;
    } else {
      const dt = new Date(validadeBruta);
      if (!isNaN(dt)) {
        const [a, m, d] = dt.toISOString().slice(0, 10).split('-');
        validadeInput = `${d}/${m}/${a}`;
      }
    }
  }
%>
<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>GreenGo - <%= editando ? 'Editar lote' : 'Adicionar lote' %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/style.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
  <style>
    body { background: #f6f8f5; }
    .modal-content { border: 0; border-radius: 18px; }
  </style>
</head>
<body>

<div class="modal fade" id="modalAdicionar" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-lg">
    <div class="modal-content shadow">
      <div class="modal-header border-0">
        <h5 class="modal-title text-success fw-bold" id="tituloModal">
          <i class="bi <%= editando ? 'bi-pencil-square' : 'bi-plus-circle' %> me-1"></i>
          <span id="textoTituloModal"><%= editando ? 'Editar lote' : 'Adicionar lote' %></span>
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
      </div>

      <div class="modal-body">
        <input type="hidden" id="idEdicao" value="<%= editando ? lote.id_lote : '' %>">
        <div class="row g-3">
          <div class="col-md-12">
            <label for="novoProduto" class="form-label">Produto *</label>
            <select class="form-select" id="novoProduto">
              <option value="0">--Selecione--</option>
              <% for (let i = 0; i < produtos.length; i++) { %>
                <option value="<%= produtos[i].id_produto %>" <%= lote.id_produto == produtos[i].id_produto ? 'selected' : '' %>><%= produtos[i].nome %></option>
              <% } %>
            </select>
            <div class="invalid-feedback">Selecione o produto.</div>
            <div class="form-text">Não encontrou? <a href="/produtos">Cadastrar produto</a></div>
          </div>
          <div class="col-md-4">
            <label for="novoNumeroLote" class="form-label">Número do lote *</label>
            <input type="text" class="form-control" id="novoNumeroLote" placeholder="Ex: L2026-001" maxlength="50" value="<%= lote.numero_lote || '' %>">
            <div class="invalid-feedback">Informe o número do lote.</div>
          </div>
          <div class="col-md-4">
            <label for="novaQuantidade" class="form-label">Quantidade atual (não editável)</label>
            <input disabled type="number" class="form-control" id="novaQuantidade" placeholder="Ex: 20" min="1" step="1" value="<%= lote.quantidade_atual !== undefined ? lote.quantidade_atual : '' %>">
          </div>
          <div class="col-md-4">
            <label for="novaValidade" class="form-label">Validade atual</label>
            <input disabled type="text" class="form-control" placeholder="dd/mm/aaaa" maxlength="10" inputmode="numeric" value="<%= validadeInput %>">
            <label for="novaValidade" class="form-label">Nova Validade *</label>
            <input  type="date" class="form-control" id="novaValidade" placeholder="dd/mm/aaaa"  value="<%= validadeInput %>">
            <div class="invalid-feedback">Informe uma data válida (dd/mm/aaaa).</div>
          </div>
          <div class="col-12">
            <p class="text-muted small mb-0" id="avisoQuantidade">
              <i class="bi bi-info-circle me-1"></i>
              Depois de criado, o estoque do lote só muda por movimentação.
            </p>
          </div>
        </div>

        <div class="alert alert-danger d-none mt-3 mb-0" id="erroAdicionarLote">
          Preencha corretamente os campos obrigatórios.
        </div>
      </div>

      <div class="modal-footer border-0">
        <button type="button" class="btn btn-light border rounded-pill px-4" data-bs-dismiss="modal">
          Cancelar
        </button>
        <button type="button" class="btn btn-success rounded-pill px-4" id="btnSalvarLote">
          <i class="bi bi-check-circle me-1"></i>
          <span id="textoBtnSalvar"><%= editando ? 'Salvar alterações' : 'Adicionar' %></span>
        </button>
      </div>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/validacao/validacoes.js"></script>
<script src="/js/produtos/lote.js"></script>
<script>
  // Abre o modal assim que a página carrega e volta para a listagem ao fechar
  var modalLote = document.getElementById('modalAdicionar');
  new bootstrap.Modal(modalLote).show();
  modalLote.addEventListener('hidden.bs.modal', function () {
    window.location.href = '/lotes';
  });
</script>

</body>
</html>
