<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>GreenGo - Gestão de Marcas</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/style.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">

  <style>
    body { background: #f6f8f5; }
    .gestao-hero { background: linear-gradient(135deg, #f4fff7, #ffffff); }
    .card-soft { border: 0; border-radius: 18px; box-shadow: 0 10px 26px rgba(20, 83, 45, 0.08); }
    .toolbar-gestao { background: #ffffff; border: 1px solid #e7efe8; border-radius: 18px; padding: 18px; }
    .btn-excluir-selecionados {
      border-radius: 999px;
      padding: 10px 18px;
      font-weight: 600;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      transition: .2s;
    }
    .btn-excluir-selecionados:disabled {
      opacity: .45;
      cursor: not-allowed;
    }
    .btn-editar-item,
    .btn-remover-produto {
      width: 38px;
      height: 38px;
      border-radius: 50%;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      transition: .2s;
    }
    .btn-editar-item {
      border: 1px solid #cfead8;
      background: #f4fff7;
      color: #198754;
    }
    .btn-editar-item:hover {
      background: #198754;
      color: #fff;
      transform: translateY(-1px);
      box-shadow: 0 8px 18px rgba(25, 135, 84, .22);
    }
    .btn-remover-produto {
      border: 1px solid #f2caca;
      background: #fff7f7;
      color: #dc3545;
    }
    .btn-remover-produto:hover {
      background: #dc3545;
      color: #fff;
      transform: translateY(-1px);
      box-shadow: 0 8px 18px rgba(220, 53, 69, .22);
    }
    .table thead th {
      background: #eaf7ee !important;
      color: #198754;
      border-bottom: 0;
    }
    .table tbody tr { transition: .15s; }
    .table tbody tr:hover { background: #fbfffc; }
    .badge-categoria {
      background: #eef9f1;
      color: #198754;
      border: 1px solid #cfead8;
      font-weight: 600;
    }
    .modal-content { border: 0; border-radius: 18px; }
    .modal-icon {
      width: 48px;
      height: 48px;
      border-radius: 50%;
      background: #fff1f1;
      color: #dc3545;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-size: 1.4rem;
    }
    .card-filtro-marca { cursor: pointer; }
    .card-filtro-marca.ativo { border: 2px solid #198754 !important; background-color: #f4fff7; }
  </style>

</head>
<body>

<nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm">
  <div class="container">
    <a class="navbar-brand fw-bold text-success d-flex align-items-center" href="/">
      <img src="/imagens-produtos/imagens/img-site/logo-greengo.jpg" alt="Logo GreenGo" width="45" height="45" class="rounded me-2">
      GreenGo
    </a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menuGestao">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="menuGestao">
      <ul class="navbar-nav ms-auto">
        <li class="nav-item"><a class="nav-link" href="/">Início</a></li>
        <li class="nav-item"><a class="nav-link" href="/clientes">Cliente</a></li>
        <li class="nav-item"><a class="nav-link" href="/fornecedores">Fornecedor</a></li>
        <li class="nav-item"><a class="nav-link active" href="/gestao-produtos">Gestão</a></li>
      </ul>
    </div>
  </div>
</nav>

<header class="bg-white border-bottom py-4">
  <div class="container text-center">
    <h1 class="fw-bold text-success">Gestão de Marcas</h1>
    <p class="text-muted mb-2">Cadastre, altere e exclua as marcas dos produtos.</p>
    <a href="/gestao-produtos" class="btn btn-sm btn-outline-success rounded-pill px-3">
      <i class="bi bi-arrow-left me-1"></i> Voltar para Gestão
    </a>
  </div>
</header>

<main class="container my-5">

  <div class="row g-3 mb-4">
    <div class="col-md-4">
      <div class="card h-100 card-soft card-resumo-gestao card-filtro-marca ativo" data-filtro="todos">
        <div class="card-body">
          <h5 class="card-title text-success"><i class="bi bi-tags me-1"></i>Total de marcas</h5>
          <p class="card-text fs-4 fw-bold mb-0" id="totalMarcas"><%= typeof totalMarcas !== 'undefined' ? totalMarcas : (lista ? lista.length : 0) %></p>
        </div>
      </div>
    </div>
    <div class="col-md-4">
      <div class="card h-100 card-soft card-resumo-gestao card-filtro-marca" data-filtro="com_produtos">
        <div class="card-body">
          <h5 class="card-title text-success"><i class="bi bi-check2-circle me-1"></i>Com produtos</h5>
          <p class="card-text fs-4 fw-bold mb-0" id="marcasComProdutos"><%= typeof marcasComProdutos !== 'undefined' ? marcasComProdutos : 0 %></p>
        </div>
      </div>
    </div>
    <div class="col-md-4">
      <div class="card h-100 card-soft card-resumo-gestao card-filtro-marca" data-filtro="sem_produtos">
        <div class="card-body">
          <h5 class="card-title text-success"><i class="bi bi-slash-circle me-1"></i>Sem produtos</h5>
          <p class="card-text fs-4 fw-bold mb-0" id="marcasSemProdutos"><%= typeof marcasSemProdutos !== 'undefined' ? marcasSemProdutos : 0 %></p>
        </div>
      </div>
    </div>
  </div>

  <div class="card card-soft">
    <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
      <h2 class="h5 mb-0 text-success">Marcas cadastradas</h2>
      <div class="d-flex align-items-center gap-2">
        <label for="filtroVinculoMarca" class="form-label mb-0 small text-muted fw-semibold">Filtrar:</label>
        <select id="filtroVinculoMarca" class="form-select form-select-sm" style="width: auto;">
          <option value="todos">Todas as marcas</option>
          <option value="com_produtos">Com produtos vinculados</option>
          <option value="sem_produtos">Sem produtos vinculados</option>
        </select>
      </div>
    </div>

    <div class="card-body">

      <div class="toolbar-gestao mb-4">
        <div class="toolbar-topo">
          <div class="toolbar-busca">
            <label for="buscaMarca" class="form-label fw-semibold">Buscar marca</label>
            <div class="input-group">
              <span class="input-group-text bg-white">
                <i class="bi bi-search text-success"></i>
              </span>
              <input type="text" class="form-control" id="buscaMarca" placeholder="Digite o nome da marca" value="<%= typeof termoBusca !== 'undefined' ? termoBusca : '' %>">
            </div>
          </div>

          <div class="toolbar-acoes" id="areaAcoesMarca">
            <button type="button" class="btn btn-success btn-adicionar-produto" id="btnAdicionar" data-bs-toggle="modal" data-bs-target="#modalAdicionar">
              <i class="bi bi-plus-circle"></i>
              Adicionar marca
            </button>

            <button class="btn btn-danger btn-excluir-selecionados" id="btnExcluirSelecionados" disabled>
              <i class="bi bi-trash3"></i>
              Excluir selecionados
              <span class="badge text-bg-light text-danger ms-1" id="qtdSelecionados">0</span>
            </button>
          </div>
        </div>
      </div>

      <div id="mensagemGestao" class="alert alert-success d-none" role="alert"></div>

      <div class="table-responsive">
        <table class="table table-hover align-middle">
          <thead>
            <tr>
              <th style="width: 45px;"><input type="checkbox" class="form-check-input" id="marcarTodos"></th>
              <th style="width: 90px;">ID</th>
              <th>Marca</th>
              <th class="text-center">Produtos vinculados</th>
              <th class="text-center">Ação</th>
            </tr>
          </thead>
          <tbody id="corpoTabelaMarcas">
            <% if (typeof lista !== 'undefined' && lista.length > 0) { %>
              <% for (let i = 0; i < lista.length; i++) { %>
                <tr class="linha-marca"
                    data-id="<%= lista[i].id_marca %>"
                    data-nome="<%= lista[i].nome %>"
                    data-produtos="<%= lista[i].total_produtos %>">
                  <td>
                    <input type="checkbox" class="form-check-input chk-marca" value="<%= lista[i].id_marca %>" data-nome="<%= lista[i].nome %>">
                  </td>
                  <td class="text-muted fw-semibold">#<%= lista[i].id_marca %></td>
                  <td class="fw-semibold"><%= lista[i].nome %></td>
                  <td class="text-center">
                    <% if (lista[i].total_produtos > 0) { %>
                      <span class="badge badge-categoria"><%= lista[i].total_produtos %> produto(s)</span>
                    <% } else { %>
                      <span class="badge text-bg-light text-muted border">Sem produtos</span>
                    <% } %>
                  </td>
                  <td class="text-center">
                    <button type="button"
                            class="btn btn-primary btnEditarMarca me-1"
                            data-id="<%= lista[i].id_marca %>"
                            data-nome="<%= lista[i].nome %>"
                            title="Editar marca">
                      <i class="fas fa-pen"></i>
                    </button>
                    <button type="button"
                            data-codigoexclusao="<%= lista[i].id_marca %>"
                            data-nome="<%= lista[i].nome %>"
                            class="btn btn-danger btnExclusao"
                            title="Excluir marca">
                      <i class="fas fa-trash"></i>
                    </button>
                  </td>
                </tr>
              <% } %>
            <% } else { %>
              <tr id="linhaSemMarcas">
                <td colspan="5" class="text-center text-muted py-4">Nenhuma marca cadastrada até o momento.</td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

</main>


<!-- Modal adicionar / editar (o mesmo modal serve para os dois) -->
<div class="modal fade" id="modalAdicionar" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content shadow">
      <div class="modal-header border-0">
        <h5 class="modal-title text-success fw-bold" id="tituloModal">
          <i class="bi bi-plus-circle me-1" id="iconeModalMarca"></i>
          <span id="textoTituloModal">Adicionar marca</span>
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
      </div>

      <div class="modal-body">
        <input type="hidden" id="idEdicao">
        <div class="row g-3">
          <div class="col-md-12">
            <label for="novoNome" class="form-label">Marca *</label>
            <input type="text" class="form-control" id="novoNome" placeholder="Ex: Hortifruti Sol" maxlength="100">
            <div class="invalid-feedback" id="feedbackNomeMarca">Informe o nome da marca (mínimo de 2 caracteres).</div>
          </div>
        </div>

        <div class="alert alert-danger d-none mt-3 mb-0" id="erroAdicionarMarca">
          Preencha corretamente os campos obrigatórios.
        </div>
      </div>

      <div class="modal-footer border-0">
        <button type="button" class="btn btn-light border rounded-pill px-4" data-bs-dismiss="modal">
          Cancelar
        </button>
        <button type="button" class="btn btn-success rounded-pill px-4" id="btnSalvarMarca">
          <i class="bi bi-check-circle me-1"></i>
          <span id="textoBtnSalvar">Adicionar</span>
        </button>
      </div>
    </div>
  </div>
</div>

<div class="modal fade" id="modalExcluir" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content shadow">
      <div class="modal-header border-0 pb-0">
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
      </div>

      <div class="modal-body text-center px-4">
        <div class="modal-icon mx-auto mb-3">
          <i class="bi bi-trash3"></i>
        </div>
        <h5 class="fw-bold mb-2">Confirmar exclusão</h5>
        <p class="text-muted mb-0" id="textoModalExcluir">Deseja realmente excluir?</p>
      </div>

      <div class="modal-footer border-0 justify-content-center pb-4">
        <button type="button" class="btn btn-light border rounded-pill px-4" data-bs-dismiss="modal">
          Cancelar
        </button>
        <button type="button" class="btn btn-danger rounded-pill px-4" id="confirmarExclusao">
          <i class="bi bi-check-circle me-1"></i> Confirmar
        </button>
      </div>
    </div>
  </div>
</div>



<footer class="bg-success text-white text-center py-3 mt-5">
  <p class="mb-2">GreenGo © 2026</p>
  <div class="footer-links-greengo">
    <a href="/clientes">Cliente</a>
    <a href="/fornecedor">Fornecedor</a>
    <a href="/gestao-produtos">Gestão</a>
    <a href="/">Início</a>
  </div>
</footer>



<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/validacao/validacoes.js"></script>
<script src="/js/validacao/gestao-marcas.js"></script>

</body>
</html>
