<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>GreenGo - Gestão de Devoluções e Descarte</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/style.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
  <style>
    body { background: #f6f8f5; }
    .card-soft { border: 0; border-radius: 18px; box-shadow: 0 10px 26px rgba(20, 83, 45, 0.08); }
    .table thead th { background: #eaf7ee !important; color: #198754; border-bottom: 0; white-space: nowrap; }
    .item-devolucao td { vertical-align: top; }
    .item-lote { min-width: 260px; }
    .item-qtd { width: 100px; }
    .item-motivo { min-width: 190px; }
    .item-obs { min-width: 200px; }
    /* Destino: os dois indicadores ficam sempre na tela; o motivo escolhido deixa um deles verde */
    .destino-ind {
      display: inline-block; padding: .35em .8em; margin: 2px 2px 2px 0;
      border-radius: 50rem; font-size: .8rem; font-weight: 600;
      background: #eef0f2; color: #9aa5ad; border: 1px solid #dfe3e6;
      cursor: default; user-select: none; white-space: nowrap;
    }
    .destino-ind.ativo { background: #198754; color: #fff; border-color: #198754; }
    /* O style.css geral pinta de verde todo botão dentro de .card.
       As regras abaixo são mais específicas e devolvem a cor certa a estes botões. */

    /* Remover linha: vermelho, para não parecer um botão de confirmar */
    .card button.btn-remover-item {
      width: 38px !important; height: 38px !important; min-height: 38px !important;
      padding: 0 !important; border-radius: 50% !important;
      border: 1px solid #f2caca !important; background: #fff7f7 !important; color: #dc3545 !important;
      font-size: 1rem !important;
      display: inline-flex; align-items: center; justify-content: center;
    }
    .card button.btn-remover-item:hover { background: #dc3545 !important; color: #fff !important; }

    /* Adicionar item: só contornado, para se diferenciar do botão principal "Registrar" */
    .card button#btnAdicionarItem {
      background: #fff !important; color: #198754 !important;
      border: 1px solid #198754 !important; border-radius: 50rem !important;
      width: auto !important; padding: .4rem 1rem !important; font-size: 1rem !important;
    }
    .card button#btnAdicionarItem:hover { background: #198754 !important; color: #fff !important; }
  </style>
</head>
<body>

<nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm">
  <div class="container">
    <a class="navbar-brand fw-bold text-success d-flex align-items-center" href="/">
      <img src="/imagens-produtos/imagens/img-site/logo-greengo.jpg" alt="Logo GreenGo" width="45" height="45" class="rounded me-2">
      GreenGo
    </a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menuGestao">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="menuGestao">
      <ul class="navbar-nav ms-auto">
        <li class="nav-item"><a class="nav-link" href="/">Início</a></li>
        <li class="nav-item"><a class="nav-link" href="/clientes">Cliente</a></li>
        <li class="nav-item"><a class="nav-link" href="/fornecedores">Fornecedor</a></li>
        <li class="nav-item"><a class="nav-link active" href="/gestao-produtos">Gestão</a></li>
      </ul>
    </div>
  </div>
</nav>

<header class="bg-white border-bottom py-4">
  <div class="container text-center">
    <h1 class="fw-bold text-success">Gestão de Devoluções e Descarte</h1>
    <p class="text-muted mb-2">
      Produto vencido ou impróprio para consumo vai para descarte. Produto em bom estado volta para o estoque.
    </p>
    <a href="/gestao-produtos" class="btn btn-sm btn-outline-success rounded-pill px-3">
      <i class="bi bi-arrow-left me-1"></i> Voltar para Gestão
    </a>
  </div>
</header>

<main class="container my-5">

  <!-- Formulário de devolução -->
  <div class="card card-soft mb-4">
    <div class="card-header bg-white border-bottom py-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
      <h2 class="h5 mb-0 text-success"><i class="bi bi-arrow-return-left me-1"></i>Registrar devolução</h2>
      <span class="text-muted small">
        <i class="bi bi-person-badge me-1"></i>
        Responsável:
        <% if (funcionario) { %>
          <b><%= funcionario.nome %></b> (matrícula <%= funcionario.matricula %>)
        <% } else { %>
          <b class="text-danger">não encontrado</b>
        <% } %>
        &nbsp;|&nbsp;
        <i class="bi bi-calendar-event me-1"></i>
        Data: <b><%= new Date().toLocaleDateString('pt-BR') %></b>
      </span>
    </div>

    <div class="card-body">

      <% if (!funcionario) { %>
        <div class="alert alert-danger">
          O funcionário responsável pelas devoluções (matrícula F0001) não foi encontrado no banco.
          Rode o script <b>db/devolucao-descarte.sql</b> no MySQL Workbench.
        </div>
      <% } %>

      <div class="table-responsive">
        <table class="table align-middle mb-2">
          <thead>
            <tr>
              <th>Produto / lote *</th>
              <th>Quantidade *</th>
              <th>Motivo *</th>
              <th>Observação</th>
              <th class="text-center">Remover</th>
              <th>Destino</th>
            </tr>
          </thead>
          <tbody id="corpoItens">
            <!-- as linhas de itens são criadas pelo JavaScript a partir do modelo abaixo -->
          </tbody>
        </table>
      </div>

      <button type="button" class="btn btn-outline-success rounded-pill px-3" id="btnAdicionarItem">
        <i class="bi bi-plus-circle me-1"></i> Adicionar item
      </button>

      <div id="mensagemDevolucao" class="alert d-none mt-3 mb-0"></div>

      <div class="text-end mt-3">
        <button type="button" class="btn btn-success rounded-pill px-4" id="btnRegistrarDevolucao" <%= funcionario ? '' : 'disabled' %>>
          <i class="bi bi-check-circle me-1"></i> Registrar
        </button>
      </div>
    </div>
  </div>

  <!-- Histórico de descartes -->
  <div class="card card-soft">
    <div class="card-header bg-white border-bottom py-3">
      <h2 class="h5 mb-0 text-success"><i class="bi bi-trash3 me-1"></i>Histórico de descartes</h2>
    </div>
    <div class="card-body">
      <div class="table-responsive">
        <table class="table table-hover align-middle">
          <thead>
            <tr>
              <th>Nº</th>
              <th>Data</th>
              <th>Responsável</th>
              <th>Produto</th>
              <th>Lote</th>
              <th>Quantidade</th>
              <th>Motivo</th>
              <th>Observação</th>
            </tr>
          </thead>
          <tbody>
            <% if (descartes.length == 0) { %>
              <tr><td colspan="8" class="text-center text-muted">Nenhum descarte registrado.</td></tr>
            <% } %>
            <% for (let i = 0; i < descartes.length; i++) { %>
              <tr>
                <td><%= descartes[i].id_descarte %></td>
                <td><%= descartes[i].data_br %></td>
                <td><%= descartes[i].funcionario || '-' %></td>
                <td><%= descartes[i].nome %></td>
                <td><%= descartes[i].numero_lote %></td>
                <td><%= descartes[i].itens_qntd %></td>
                <td><%= descartes[i].motivo %></td>
                <td><%= descartes[i].observacao || '-' %></td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- Histórico de devoluções ao estoque -->
  <div class="card card-soft mt-4">
    <div class="card-header bg-white border-bottom py-3">
      <h2 class="h5 mb-0 text-success"><i class="bi bi-box-arrow-in-down me-1"></i>Histórico de devoluções ao estoque</h2>
    </div>
    <div class="card-body">
      <div class="table-responsive">
        <table class="table table-hover align-middle">
          <thead>
            <tr>
              <th>Nº</th>
              <th>Data</th>
              <th>Responsável</th>
              <th>Produto</th>
              <th>Lote</th>
              <th>Quantidade</th>
              <th>Motivo</th>
              <th>Observação</th>
            </tr>
          </thead>
          <tbody>
            <% if (devolucoes.length == 0) { %>
              <tr><td colspan="8" class="text-center text-muted">Nenhuma devolução ao estoque registrada.</td></tr>
            <% } %>
            <% for (let i = 0; i < devolucoes.length; i++) { %>
              <tr>
                <td><%= devolucoes[i].id_devolucao %></td>
                <td><%= devolucoes[i].data_br %></td>
                <td><%= devolucoes[i].funcionario || '-' %></td>
                <td><%= devolucoes[i].nome %></td>
                <td><%= devolucoes[i].numero_lote %></td>
                <td><%= devolucoes[i].itens_qntd %></td>
                <td><%= devolucoes[i].motivo %></td>
                <td><%= devolucoes[i].observacao || '-' %></td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

</main>

<!-- Modelo de uma linha de item (o JavaScript copia este modelo a cada "Adicionar item") -->
<template id="modeloItem">
  <tr class="item-devolucao">
    <td>
      <select class="form-select item-lote">
        <option value="0">--Selecione--</option>
        <% for (let i = 0; i < lotes.length; i++) { %>
          <option value="<%= lotes[i].id_lote %>"
                  data-vencido="<%= lotes[i].vencido %>"
                  data-inicial="<%= lotes[i].quantidade_inicial %>"
                  data-numero="<%= lotes[i].numero_lote %>">
            <%= lotes[i].nome %> — Lote <%= lotes[i].numero_lote %> — Val. <%= lotes[i].validade_br %> — Estoque: <%= lotes[i].quantidade_atual %><%= lotes[i].vencido == 1 ? ' (VENCIDO)' : '' %>
          </option>
        <% } %>
      </select>
      <div class="small mt-1 item-aviso"></div>
    </td>
    <td>
      <input type="number" class="form-control item-qtd" min="1" step="1" placeholder="Ex: 2">
      <div class="small text-muted mt-1 item-limite"></div>
    </td>
    <td>
      <select class="form-select item-motivo">
        <option value="">--Selecione--</option>
        <option value="VENCIDO">Vencido</option>
        <option value="IMPROPRIO">Impróprio para consumo</option>
        <option value="OUTRO">Outro</option>
      </select>
    </td>
    <td>
      <input type="text" class="form-control item-obs" maxlength="255" placeholder="Opcional">
    </td>
    <td class="text-center">
      <button type="button" class="btn btn-remover-item" title="Remover esta linha" aria-label="Remover esta linha">
        <i class="bi bi-trash3"></i>
      </button>
    </td>
    <td class="text-nowrap">
      <!-- só indicam o destino (não são clicáveis): o motivo escolhido deixa um deles verde -->
      <span class="destino-ind" data-destino="DEVOLUCAO">Devolução</span>
      <span class="destino-ind" data-destino="DESCARTE">Descarte</span>
    </td>
  </tr>
</template>

<footer class="bg-success text-white text-center py-3 mt-5">
  <p class="mb-0">GreenGo © 2026</p>
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/util/mensagem.js"></script>
<script src="/js/descarte/descarte.js"></script>
</body>
</html>