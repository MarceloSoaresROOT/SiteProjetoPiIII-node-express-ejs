<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>GreenGo - Cadastro de Cliente</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="style.css">
</head>
<body class="bg-light">

<nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm">
  <div class="container">
    <a class="navbar-brand fw-bold text-success d-flex align-items-center" href="/index">
      <img src="/imagens-produtos/imagens/img-site/logo-greengo.jpg" alt="Logo GreenGo" width="45" height="45" class="rounded me-2">
      GreenGo
    </a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menuCliente">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="menuCliente">
      <ul class="navbar-nav ms-auto">
        <li class="nav-item"><a class="nav-link" href="/index">Início</a></li>
        <li class="nav-item"><a class="nav-link active" href="/cadastro-clientes">Cliente</a></li>
        <li class="nav-item"><a class="nav-link" href="/cadastro-fornecedores">Fornecedor</a></li>
        <li class="nav-item"><a class="nav-link" href="/gestao-produtos">Gestão</a></li>
      </ul>
    </div>
  </div>
</nav>

<header class="bg-white border-bottom py-4">
  <div class="container text-center">
    <h1 class="fw-bold text-success">Cadastro de Cliente</h1>
    <p class="text-muted mb-0">Preencha seus dados para agilizar compras e entregas.</p>
  </div>
</header>

<main class="container my-5">
  <form id="formClienteCompleto" class="bg-white rounded-4 shadow-sm p-4 p-md-5" novalidate>
    <h2 class="h4 text-success mb-4">Dados pessoais</h2>
    <div class="row g-3">
      <div class="col-md-8">
        <label for="cliNome" class="form-label">Nome completo *</label>
        <input type="text" class="form-control" id="cliNome" required minlength="3">
        <div class="invalid-feedback">Digite somente letras e pelo menos 3 caracteres.</div>
      </div>
      <div class="col-md-4">
        <label for="cliCpf" class="form-label">CPF *</label>
        <input type="text" class="form-control" id="cliCpf" required maxlength="14" placeholder="000.000.000-00" onkeyup="mascara('###.###.###-##',this,event)">
        <div class="invalid-feedback">Informe um CPF válido.</div>
      </div>
      <div class="col-md-4">
        <label for="cliNascimento" class="form-label">Data de nascimento *</label>
        <input 
          type="date" 
          class="form-control" 
          id="cliNascimento"
          min="1920-01-01"
          max="2026-12-31"
          onblur="validarDataNascimento()"
          required
        >
        <div class="invalid-feedback" id="erroData">Informe uma data entre 1920 e 2026.</div>
      </div>

      <div class="col-md-4">
        <label for="cliCelular" class="form-label">Celular *</label>
        <input type="text" class="form-control" id="cliCelular" required maxlength="15" placeholder="(18) 99999-9999" onkeyup="mascara('(##) #####-####',this,event)">
        <div class="invalid-feedback">Informe o celular completo.</div>
      </div>
      <div class="col-md-4">
        <label for="cliTelefone" class="form-label">Telefone</label>
        <input type="text" class="form-control" id="cliTelefone" maxlength="14" placeholder="(18) 9999-9999" onkeyup="mascara('(##) ####-####',this,event)">
        <div class="invalid-feedback">Telefone incompleto.</div>
      </div>
      <div class="col-md-6">
        <label for="cliEmail" class="form-label">E-mail *</label>
        <input type="email" class="form-control" id="cliEmail" required>
        <div class="invalid-feedback">Informe um e-mail válido.</div>
      </div>
      <div class="col-md-6">
        <label for="cliEmailConf" class="form-label">Confirmar e-mail *</label>
        <input type="email" class="form-control" id="cliEmailConf" required>
        <div class="invalid-feedback">Os e-mails precisam ser iguais.</div>
      </div>
    </div>

    <hr class="my-4">
    <h2 class="h4 text-success mb-4">Endereço</h2>
    <div class="row g-3">
      <div class="col-md-3">
        <label for="cliCep" class="form-label">CEP *</label>
        <input type="text" class="form-control" id="cliCep" required maxlength="9" placeholder="00000-000" onkeyup="mascara('#####-###',this,event)">
        <div class="invalid-feedback">Informe o CEP completo.</div>
        <div class="form-text text-danger" id="erroCepCliente"></div>
      </div>
      <div class="col-md-6">
        <label for="cliRua" class="form-label">Endereço *</label>
        <input type="text" class="form-control" id="cliRua" required minlength="4">
        <div class="invalid-feedback">Informe o endereço.</div>
      </div>
      <div class="col-md-3">
        <label for="cliNumero" class="form-label">Número *</label>
        <input type="number" class="form-control" id="cliNumero" required min="1">
        <div class="invalid-feedback">Informe um número válido.</div>
      </div>
      <div class="col-md-4">
        <label for="cliBairro" class="form-label">Bairro *</label>
        <input type="text" class="form-control" id="cliBairro" required minlength="3">
        <div class="invalid-feedback">Informe o bairro.</div>
      </div>
      <div class="col-md-4">
        <label for="cliCidade" class="form-label">Cidade *</label>
        <input type="text" class="form-control" id="cliCidade" required minlength="3">
        <div class="invalid-feedback">Informe a cidade.</div>
      </div>
      <div class="col-md-2">
        <label for="cliEstado" class="form-label">Estado *</label>
        <select class="form-select" id="cliEstado" required>
          <option value="">UF</option>
          <option>SP</option><option>PR</option><option>MG</option><option>MS</option><option>RJ</option>
        </select>
        <div class="invalid-feedback">Selecione o estado.</div>
      </div>
      <div class="col-md-2">
        <label for="cliComplemento" class="form-label">Complemento</label>
        <input type="text" class="form-control" id="cliComplemento" maxlength="40">
      </div>
    </div>

    <hr class="my-4">
    <h2 class="h4 text-success mb-4">Preferências</h2>
    <div class="row g-3">
      <div class="col-md-4">
        <label for="cliEntrega" class="form-label">Preferência de entrega *</label>
        <select class="form-select" id="cliEntrega" required>
          <option value="">Selecione</option>
          <option>Manhã</option><option>Tarde</option><option>Noite</option><option>Retirada no local</option>
        </select>
        <div class="invalid-feedback">Selecione uma preferência.</div>
      </div>
      <div class="col-md-4">
        <label for="cliPagamento" class="form-label">Pagamento preferido *</label>
        <select class="form-select" id="cliPagamento" required>
          <option value="">Selecione</option>
          <option>Pix</option><option>Cartão</option><option>Dinheiro</option>
        </select>
        <div class="invalid-feedback">Selecione uma forma de pagamento.</div>
      </div>
      <div class="col-md-4">
        <label for="cliSenha" class="form-label">Senha *</label>
        <input type="password" class="form-control" id="cliSenha" required minlength="6">
        <div class="invalid-feedback">A senha deve ter pelo menos 6 caracteres.</div>
      </div>
      <div class="col-md-4">
        <label for="cliSenhaConf" class="form-label">Confirmar senha *</label>
        <input type="password" class="form-control" id="cliSenhaConf" required>
        <div class="invalid-feedback">As senhas precisam ser iguais.</div>
      </div>
      <div class="col-md-8">
        <label class="form-label d-block">Interesses *</label>
        <div class="form-check form-check-inline">
          <input class="form-check-input interesse-cliente" type="checkbox" id="intFrutas" value="Frutas">
          <label class="form-check-label" for="intFrutas">Frutas</label>
        </div>
        <div class="form-check form-check-inline">
          <input class="form-check-input interesse-cliente" type="checkbox" id="intLegumes" value="Legumes">
          <label class="form-check-label" for="intLegumes">Legumes</label>
        </div>
        <div class="form-check form-check-inline">
          <input class="form-check-input interesse-cliente" type="checkbox" id="intVerduras" value="Verduras">
          <label class="form-check-label" for="intVerduras">Verduras</label>
        </div>
        <div class="invalid-feedback d-block" id="erroInteresses"></div>
      </div>
      <div class="col-12">
        <label for="cliObs" class="form-label">Observações</label>
        <textarea class="form-control" id="cliObs" rows="3" maxlength="250" placeholder="Exemplo: preferência de entrega, ponto de referência ou observações do pedido."></textarea>
        <div class="form-text"><span id="contadorObsCliente">0</span>/250 caracteres</div>
        <div class="invalid-feedback">A observação deve ter pelo menos 10 caracteres, se preenchida.</div>
      </div>
    </div>

    <div class="alert alert-success mt-4 d-none" id="msgSucessoCliente">Cliente cadastrado com sucesso.</div>

    <div class="d-flex justify-content-between flex-wrap gap-2 mt-4">
      <a href="/index" class="btn btn-outline-secondary">Voltar</a>
      <div>
        <button type="reset" class="btn btn-outline-danger me-2" id="btnLimparCliente">Limpar</button>
       <button type="submit" class="btn btn-success">Cadastrar cliente</button>
      </div>
    </div>
  </form>
</main>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="validacoes.js"></script>
<script src="cliente-validacao.js"></script>

<footer class="bg-success text-white text-center py-3 mt-5">
  <div class="container">
    <p class="mb-2">GreenGo © 2026</p>
    <div class="footer-links-greengo">
      <a href="/cadastro-clientes">Cliente</a>
      <a href="/cadastro-fornecedores">Fornecedor</a>
      <a href="/gestao-produtos">Gestão</a>
      <a href="/index">Início</a>
    </div>
  </div>
</footer>
</body>
</html>