<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>GreenGo - Cadastro de Fornecedor</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="style.css">
</head>
<body class="bg-light">

<nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm">
  <div class="container">
    <a class="navbar-brand fw-bold text-success d-flex align-items-center" href="/index">
      <img src="/imagens-produtos/imagens/img-site/logo-greengo.jpg" alt="Logo GreenGo" width="45" height="45" class="rounded me-2">
      GreenGo
    </a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menuFornecedor">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="menuFornecedor">
      <ul class="navbar-nav ms-auto">
        <li class="nav-item"><a class="nav-link" href="/index">Início</a></li>
        <li class="nav-item"><a class="nav-link" href="/cadastro-clientes">Cliente</a></li>
        <li class="nav-item"><a class="nav-link active" href="/cadastro-fornecedores">Fornecedor</a></li>
        <li class="nav-item"><a class="nav-link" href="/gestao-produtos">Gestão</a></li>
      </ul>
    </div>
  </div>
</nav>

<header class="bg-white border-bottom py-4">
  <div class="container text-center">
    <h1 class="fw-bold text-success">Cadastro de Fornecedor</h1>
    <p class="text-muted mb-0">Preencha os dados necessários para cadastrar um fornecedor da GreenGo.</p>
  </div>
</header>

<main class="container my-5">
  <form id="formCadastroFornecedor" class="bg-white rounded-4 shadow-sm p-4 p-md-5" novalidate>
    <h2 class="h4 text-success mb-4">Dados da empresa</h2>

    <div class="row g-3">
      <div class="col-md-6">
        <label for="razaoSocial" class="form-label">Razão Social *</label>
        <input type="text" class="form-control" id="razaoSocial" placeholder="Ex: Fazenda Boa Terra LTDA" required>
        <div class="invalid-feedback">Informe a razão social com pelo menos 3 caracteres.</div>
      </div>
      <div class="col-md-6">
        <label for="nomeFantasia" class="form-label">Nome Fantasia *</label>
        <input type="text" class="form-control" id="nomeFantasia" placeholder="Ex: Sítio Boa Terra" required>
        <div class="invalid-feedback">Informe o nome fantasia com pelo menos 3 caracteres.</div>
      </div>

      <div class="col-md-4">
        <label for="cnpj" class="form-label">CNPJ *</label>
        <input type="text" class="form-control" id="cnpj" placeholder="99.999.999/9999-99" maxlength="18" required onkeyup="mascara('##.###.###/####-##',this,event)">
        <div class="invalid-feedback">Informe um CNPJ válido.</div>
      </div>
      <div class="col-md-4">
        <label for="inscricaoEstadual" class="form-label">Inscrição Estadual</label>
        <input type="text" class="form-control" id="inscricaoEstadual" placeholder="Somente números" maxlength="15" onkeyup="somenteNumeroCampo(this)">
        <div class="invalid-feedback">Use apenas números.</div>
      </div>
      <div class="col-md-4">
        <label for="dataCadastro" class="form-label">Data do cadastro *</label>
        <input type="date" class="form-control" id="dataCadastro" required>
        <div class="invalid-feedback">A data não pode ser futura.</div>
      </div>
    </div>

    <hr class="my-4">
    <h2 class="h4 text-success mb-4">Contato</h2>

    <div class="row g-3">
      <div class="col-md-6">
        <label for="responsavel" class="form-label">Responsável *</label>
        <input type="text" class="form-control" id="responsavel" placeholder="Nome do responsável" required>
        <div class="invalid-feedback">Informe um nome sem números.</div>
      </div>
      <div class="col-md-6">
        <label for="email" class="form-label">E-mail *</label>
        <input type="email" class="form-control" id="email" placeholder="fornecedor@email.com" required>
        <div class="invalid-feedback">Informe um e-mail válido.</div>
      </div>
      <div class="col-md-4">
        <label for="telefone" class="form-label">Telefone *</label>
        <input type="text" class="form-control" id="telefone" placeholder="(18)9999-9999" maxlength="14" required onkeypress="mTel(this)">
        <div class="invalid-feedback">Informe um telefone válido.</div>
      </div>
      <div class="col-md-4">
        <label for="celular" class="form-label">Celular</label>
        <input type="text" class="form-control" id="celular" placeholder="(18)99999-9999" maxlength="14" onkeyup="mascara('(##)#####-####',this,event)">
        <div class="invalid-feedback">Informe um celular válido.</div>
      </div>
      <div class="col-md-4">
        <label for="site" class="form-label">Site ou rede social</label>
        <input type="url" class="form-control" id="site" placeholder="https://exemplo.com.br">
      </div>
    </div>

    <hr class="my-4">
    <h2 class="h4 text-success mb-4">Endereço</h2>

    <div class="row g-3">
      <div class="col-md-3">
        <label for="cep" class="form-label">CEP *</label>
        <input type="text" class="form-control" id="cep" placeholder="99999-999" maxlength="9" required onkeyup="mascara('#####-###',this,event)">
        <div class="invalid-feedback">Informe um CEP válido.</div>
        <div class="form-text text-danger" id="erroCepFornecedor"></div>
      </div>
      <div class="col-md-6">
        <label for="logradouro" class="form-label">Endereço *</label>
        <input type="text" class="form-control" id="logradouro" required>
        <div class="invalid-feedback">Informe o endereço.</div>
      </div>
      <div class="col-md-3">
        <label for="numero" class="form-label">Número *</label>
        <input type="text" class="form-control" id="numero" required onkeyup="somenteNumeroCampo(this)">
        <div class="invalid-feedback">Informe o número.</div>
      </div>
      <div class="col-md-4">
        <label for="bairro" class="form-label">Bairro *</label>
        <input type="text" class="form-control" id="bairro" required>
        <div class="invalid-feedback">Informe o bairro.</div>
      </div>
      <div class="col-md-4">
        <label for="cidade" class="form-label">Cidade *</label>
        <input type="text" class="form-control" id="cidade" required>
        <div class="invalid-feedback">Informe a cidade sem números.</div>
      </div>
      <div class="col-md-2">
        <label for="estado" class="form-label">Estado *</label>
        <select class="form-select" id="estado" required>
          <option value="">UF</option>
          <option value="SP">SP</option><option value="PR">PR</option><option value="MG">MG</option>
          <option value="MS">MS</option><option value="RJ">RJ</option><option value="SC">SC</option>
        </select>
        <div class="invalid-feedback">Selecione o estado.</div>
      </div>
      <div class="col-md-2">
        <label for="complemento" class="form-label">Complemento</label>
        <input type="text" class="form-control" id="complemento">
      </div>
    </div>

    <hr class="my-4">
    <h2 class="h4 text-success mb-4">Fornecimento</h2>

    <div class="row g-3">
      <div class="col-md-4">
        <label for="categoriaPrincipal" class="form-label">Categoria principal *</label>
        <select class="form-select" id="categoriaPrincipal" required>
          <option value="">Selecione</option>
          <option value="Frutas">Frutas</option>
          <option value="Legumes">Legumes</option>
          <option value="Verduras">Verduras</option>
          <option value="Orgânicos">Orgânicos</option>
        </select>
        <div class="invalid-feedback">Selecione uma categoria.</div>
      </div>
      <div class="col-md-4">
        <label for="valorMinimo" class="form-label">Valor mínimo do pedido *</label>
        <input type="text" class="form-control" id="valorMinimo" placeholder="R$ 0,00" required onkeypress="mMoeda(this)">
        <div class="invalid-feedback">Informe valor entre R$ 50,00 e R$ 50.000,00.</div>
      </div>
      <div class="col-md-4">
        <label for="prazoEntrega" class="form-label">Prazo de entrega *</label>
        <select class="form-select" id="prazoEntrega" required>
          <option value="">Selecione</option>
          <option value="1">1 dia útil</option>
          <option value="2">2 dias úteis</option>
          <option value="3">3 dias úteis</option>
          <option value="5">5 dias úteis</option>
        </select>
        <div class="invalid-feedback">Selecione o prazo.</div>
      </div>

      <div class="col-md-6">
        <label class="form-label d-block">Tipo de entrega *</label>
        <div class="form-check form-check-inline">
          <input class="form-check-input" type="radio" name="tipoEntrega" id="entregaPropria" value="Entrega própria">
          <label class="form-check-label" for="entregaPropria">Entrega própria</label>
        </div>
        <div class="form-check form-check-inline">
          <input class="form-check-input" type="radio" name="tipoEntrega" id="retiradaLocal" value="Retirada">
          <label class="form-check-label" for="retiradaLocal">Retirada</label>
        </div>
        <div class="invalid-feedback d-block" id="erroEntrega"></div>
      </div>

      <div class="col-md-6">
        <label class="form-label d-block">Produtos fornecidos *</label>
        <div class="form-check form-check-inline">
          <input class="form-check-input produto-fornecido" type="checkbox" id="prodFrutas" value="Frutas">
          <label class="form-check-label" for="prodFrutas">Frutas</label>
        </div>
        <div class="form-check form-check-inline">
          <input class="form-check-input produto-fornecido" type="checkbox" id="prodLegumes" value="Legumes">
          <label class="form-check-label" for="prodLegumes">Legumes</label>
        </div>
        <div class="form-check form-check-inline">
          <input class="form-check-input produto-fornecido" type="checkbox" id="prodVerduras" value="Verduras">
          <label class="form-check-label" for="prodVerduras">Verduras</label>
        </div>
        <div class="invalid-feedback d-block" id="erroProdutos"></div>
      </div>

      <div class="col-12">
        <label for="observacoes" class="form-label">Observações</label>
        <textarea class="form-control" id="observacoes" rows="3" maxlength="300" placeholder="Descreva condições de entrega, produtos sazonais ou observações importantes."></textarea>
        <div class="form-text"><span id="contadorObs">0</span>/300 caracteres</div>
        <div class="invalid-feedback">A observação deve ter pelo menos 10 caracteres, se preenchida.</div>
      </div>
    </div>

    <div class="alert alert-success mt-4 d-none" id="msgSucesso">Fornecedor cadastrado com sucesso.</div>

    <div class="d-flex justify-content-between flex-wrap gap-2 mt-4">
      <a href="/gestao-produtos" class="btn btn-outline-secondary">Voltar</a>
      <div>
        <button type="reset" class="btn btn-outline-danger me-2" id="btnLimpar">Limpar</button>
        <button type="submit" class="btn btn-success">Cadastrar fornecedor</button>
      </div>
    </div>
  </form>
</main>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="js/validacao/validacoes.js"></script>
<script src="js/validacao/fornecedor-validacao.js"></script>

<footer class="bg-success text-white text-center py-3 mt-5">
  <div class="container">
    <p class="mb-2">GreenGo © 2026</p>
    <div class="footer-links-greengo">
      <a href="/cadastro-clientes">Cliente</a>
      <a href="/cadastro-fornecedores">Fornecedor</a>
      <a href="/gestao-produtos">Gestão</a>
      <a href="/index">Início</a>
    </div>
  </div>
</footer>
</body>
</html>