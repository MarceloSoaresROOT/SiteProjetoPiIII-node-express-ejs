<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>GreenGo - Gestão</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="style.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

  <style>
    body { background: #f6f8f5; }
    .card-soft { border: 0; border-radius: 18px; box-shadow: 0 10px 26px rgba(20, 83, 45, 0.08); }

    .titulo-secao {
      display: flex;
      align-items: center;
      gap: 10px;
      color: #198754;
      font-weight: 700;
      font-size: 1.15rem;
      margin-bottom: 14px;
    }
    .titulo-secao::after {
      content: "";
      flex: 1;
      height: 1px;
      background: #dcebe0;
    }

    .card-gestao-link {
      transition: transform .2s ease, box-shadow .2s ease;
    }
    .card-gestao-link:hover {
      transform: translateY(-4px);
      box-shadow: 0 16px 34px rgba(20, 83, 45, 0.16);
    }
    .card-gestao-link .icone-gestao {
      width: 56px;
      height: 56px;
      border-radius: 16px;
      background: #eaf7ee;
      color: #198754;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-size: 1.7rem;
      transition: .2s;
    }
    .card-gestao-link:hover .icone-gestao {
      background: #198754;
      color: #fff;
    }
    .card-gestao-link .acessar-gestao {
      color: #198754;
      font-weight: 600;
      font-size: .9rem;
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }
    .card-gestao-link:hover .acessar-gestao i {
      transform: translateX(4px);
    }
    .card-gestao-link .acessar-gestao i { transition: .2s; }
  </style>

</head>
<body>

<nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm">
  <div class="container">
    <a class="navbar-brand fw-bold text-success d-flex align-items-center" href="/">
      <img src="/imagens-produtos/imagens/img-site/logo-greengo.jpg" alt="Logo GreenGo" width="45" height="45" class="rounded me-2">
      GreenGo
    </a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menuGestao">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="menuGestao">
      <ul class="navbar-nav ms-auto">
        <li class="nav-item"><a class="nav-link" href="/">Início</a></li>
        <li class="nav-item"><a class="nav-link" href="/clientes">Cliente</a></li>
        <li class="nav-item"><a class="nav-link" href="/fornecedores">Fornecedor</a></li>
        <li class="nav-item"><a class="nav-link" href="/gestao-produtos">Gestão</a></li>
      </ul>
    </div>
  </div>
</nav>

<header class="bg-white border-bottom py-4">
  <div class="container text-center">
    <h1 class="fw-bold text-success">Gestão</h1>
    <p class="text-muted mb-0">Escolha o que deseja gerenciar na GreenGo.</p>
  </div>
</header>

<main class="container my-5">

  <!-- Cadastros de pessoas -->
  <section class="row g-3 mb-4 atalhos-cadastros-gestao">
    <div class="col-md-6">
      <a href="/clientes" class="text-decoration-none">
        <div class="card h-100 card-soft card-resumo-gestao">
          <div class="card-body">
            <h5 class="card-title text-success">
              <i class="bi bi-person-plus me-1"></i>
              Gestão de clientes
            </h5>
            <p class="card-text text-muted mb-0">
              Abrir gestão de clientes.
            </p>
          </div>
        </div>
      </a>
    </div>
      <div class="col-md-6">
      <a href="/funcionarios" class="text-decoration-none">
        <div class="card h-100 card-soft card-resumo-gestao">
          <div class="card-body">
            <h5 class="card-title text-success">
              <i class="bi bi-person-workspace me-1"></i>
              Gestão de funcionarios
            </h5>
            <p class="card-text text-muted mb-0">
              Abrir Gestão de funcionarios.
            </p>
          </div>
        </div>
      </a>
    </div>

    <div class="col-md-6">
      <a href="/fornecedores" class="text-decoration-none">
        <div class="card h-100 card-soft card-resumo-gestao">
          <div class="card-body">
            <h5 class="card-title text-success">
              <i class="bi bi-truck me-1"></i>
              Gestão de fornecedores
            </h5>
            <p class="card-text text-muted mb-0">
              Abrir gestão de fornecedores.
            </p>
          </div>
        </div>
      </a>
    </div>
  </section>

  <!-- Gestão do catálogo -->
  <h2 class="titulo-secao"><i class="bi bi-grid-3x3-gap"></i> Gestão do catálogo</h2>

  <section class="row g-3">
    <div class="col-md-6 col-xl-3">
      <a href="/produtos" class="text-decoration-none">
        <div class="card h-100 card-soft card-gestao-link">
          <div class="card-body d-flex flex-column">
            <span class="icone-gestao mb-3"><i class="bi bi-box-seam"></i></span>
            <h5 class="card-title text-success fw-bold">Gestão de produtos</h5>
            <p class="card-text text-muted">
              Liste, adicione, altere e exclua os produtos da GreenGo.
            </p>
            <span class="acessar-gestao mt-auto">Acessar <i class="bi bi-arrow-right"></i></span>
          </div>
        </div>
      </a>
    </div>

    <div class="col-md-6 col-xl-3">
      <a href="/marcas" class="text-decoration-none">
        <div class="card h-100 card-soft card-gestao-link">
          <div class="card-body d-flex flex-column">
            <span class="icone-gestao mb-3"><i class="bi bi-tags"></i></span>
            <h5 class="card-title text-success fw-bold">Gestão de marcas</h5>
            <p class="card-text text-muted">
              Cadastre e organize as marcas dos produtos.
            </p>
            <span class="acessar-gestao mt-auto">Acessar <i class="bi bi-arrow-right"></i></span>
          </div>
        </div>
      </a>
    </div>

    <div class="col-md-6 col-xl-3">
      <a href="/categorias" class="text-decoration-none">
        <div class="card h-100 card-soft card-gestao-link">
          <div class="card-body d-flex flex-column">
            <span class="icone-gestao mb-3"><i class="bi bi-grid"></i></span>
            <h5 class="card-title text-success fw-bold">Gestão de categorias</h5>
            <p class="card-text text-muted">
              Defina as categorias como frutas, legumes e verduras.
            </p>
            <span class="acessar-gestao mt-auto">Acessar <i class="bi bi-arrow-right"></i></span>
          </div>
        </div>
      </a>
    </div>

    <div class="col-md-6 col-xl-3">
      <a href="/lotes" class="text-decoration-none">
        <div class="card h-100 card-soft card-gestao-link">
          <div class="card-body d-flex flex-column">
            <span class="icone-gestao mb-3"><i class="bi bi-boxes"></i></span>
            <h5 class="card-title text-success fw-bold">Gestão de lotes</h5>
            <p class="card-text text-muted">
              Controle validade e quantidade de cada lote em estoque.
            </p>
            <span class="acessar-gestao mt-auto">Acessar <i class="bi bi-arrow-right"></i></span>
          </div>
        </div>
      </a>
    </div>
  </section>

</main>

<footer class="bg-success text-white text-center py-3 mt-5">
  <p class="mb-2">GreenGo © 2026</p>
  <div class="footer-links-greengo">
    <a href="/clientes">Cliente</a>
    <a href="/fornecedor">Fornecedor</a>
    <a href="/gestao-produtos">Gestão</a>
    <a href="/">Início</a>
  </div>
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="js/validacao/gestao.js"></script>

</body>
</html>
