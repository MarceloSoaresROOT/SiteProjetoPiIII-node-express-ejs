<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>GreenGo - Promoções</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="style.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
  <script src="/js/promocao/promocao.js"></script>
  <script src="/js/promocao/promocaoAlterar.js"></script>
<style>
    body { background: #f6f8f5; }
    .card-soft { border: 0; border-radius: 18px; box-shadow: 0 10px 26px rgba(20, 83, 45, 0.08); }
    .table thead th { color: #198754; font-weight: 600; border-bottom: 2px solid #dcebe0; }
  </style>
</head>
<body>

<nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm">
  <div class="container">
    <a class="navbar-brand fw-bold text-success d-flex align-items-center" href="/">
      <img src="/imagens-produtos/imagens/img-site/logo-greengo.jpg" alt="Logo GreenGo" width="45" height="45" class="rounded me-2">
      GreenGo
    </a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menuGestao">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="menuGestao">
      <ul class="navbar-nav ms-auto">
        <li class="nav-item"><a class="nav-link" href="/">Início</a></li>
        <li class="nav-item"><a class="nav-link" href="/clientes">Cliente</a></li>
        <li class="nav-item"><a class="nav-link" href="/fornecedores">Fornecedor</a></li>
        <li class="nav-item"><a class="nav-link" href="/gestao-produtos">Gestão</a></li>
      </ul>
    </div>
  </div>
</nav>

<header class="bg-white border-bottom py-4">
  <div class="container text-center">
    <h1 class="fw-bold text-success">Promoções</h1>
    <p class="text-muted mb-0">Lotes que vencem nos próximos 30 dias.</p>
  </div>
</header>

<main class="container my-5">
  <div class="card card-soft">
    <div class="card-body">
      <div class="table-responsive">
        <table class="table align-middle mb-0">
          <thead>
            <tr>
              <th>Produto</th>
              <th>Lote</th>
              <th>Validade</th>
              <th>Vence em</th>
              <th class="text-end">Quantidade</th>
              <th class="text-end">Ação</th>
            </tr>
          </thead>
          <tbody>
            <%
              var statusPorLote = {};
              (promocoes || []).forEach(function(p) {
                statusPorLote[String(p.id_lote)] = p.ativa;
              });
            %>
            <% if (lotes && lotes.length > 0) { %>
              <% lotes.forEach(function(l) {
                   var validade = new Date(l.data_validade);
                   var hoje = new Date();
                   hoje.setHours(0, 0, 0, 0);
                   var dias = Math.round((validade - hoje) / 86400000);
                   var classe = dias <= 7 ? 'text-bg-danger' : (dias <= 15 ? 'text-bg-warning' : 'text-bg-success');
                   var pad = function(n) { return String(n).padStart(2, '0'); };
                   var validadeISO = validade.getFullYear() + '-' + pad(validade.getMonth() + 1) + '-' + pad(validade.getDate());
                   var hojeISO = hoje.getFullYear() + '-' + pad(hoje.getMonth() + 1) + '-' + pad(hoje.getDate());
              %>
                <tr>
                  <td class="fw-semibold"><%= l.nome %></td>
                  <td><%= l.numero_lote %></td>
                  <td><%= validade.toLocaleDateString('pt-BR') %></td>
                  <td><span class="badge <%= classe %>"><%= dias <= 0 ? 'Hoje' : (dias === 1 ? '1 dia' : dias + ' dias') %></span></td>
                  <td class="text-end"><%= l.quantidade_atual %></td>
                <td class="text-end">
                  <% var statusLote = statusPorLote[String(l.id_lote)]; %>
                  <% if (statusLote === 'S') { %>
                    <span class="badge text-bg-success">Promoção ativa</span>
                  <% } else if (statusLote === 'N') { %>
                    <span class="badge text-bg-secondary">Promoção inativa</span>
                  <% } else { %>
                    <button class="btn btn-sm btn-success" type="button" data-bs-toggle="collapse" data-bs-target="#promo-<%= l.id_lote %>" aria-expanded="false" aria-controls="promo-<%= l.id_lote %>">
                      <i class="bi bi-percent me-1"></i>Cadastrar promoção
                    </button>
                  <% } %>
              </td>
                </tr>
                <tr class="collapse" id="promo-<%= l.id_lote %>">
                  <td colspan="6" class="bg-light">
                    <form class="form-promocao row g-3 p-2">
                      <input type="hidden" id="id_lote" name="id_lote" value="<%= l.id_lote %>">
                      <input type="hidden" id="id_produto" name="id_produto" value="<%= l.id_produto %>">

                      <div class="col-12">
                        <label class="form-label w-100">Descrição
                          <input type="text" id="descricao" name="descricao" class="form-control mt-1" maxlength="200" placeholder="Ex.: Oferta de lote próximo do vencimento">
                        </label>
                      </div>

                      <div class="col-6 col-md-3">
                        <label class="form-label w-100">Desconto (%)
                          <input type="number" id="percentual_desconto" name="percentual_desconto" class="form-control mt-1" min="1" max="99" step="0.01" required>
                        </label>
                      </div>

                      <div class="col-6 col-md-3">
                        <label class="form-label w-100">Quantidade
                          <input type="number" id="itens_qntd" name="itens_qntd" class="form-control mt-1" min="1" max="<%= l.quantidade_atual %>" required>
                        </label>
                        <div class="form-text">Máximo: <%= l.quantidade_atual %></div>
                      </div>

                      <div class="col-6 col-md-3">
                        <label class="form-label w-100">Início
                          <input type="date" id="data_inicio" name="data_inicio" class="form-control mt-1" value="<%= hojeISO %>" min="<%= hojeISO %>" max="<%= validadeISO %>" required>
                        </label>
                      </div>

                      <div class="col-6 col-md-3">
                        <label class="form-label w-100">Fim (validade do lote)
                          <input type="date" id="data_fim" name="data_fim" class="form-control mt-1" value="<%= validadeISO %>" disabled>
                        </label>
                      </div>

                    <div class="col-6 col-md-3">
                        <select id="ativo" name="ativo" class="form-select w-100">
                            <option value="">Selecione</option>
                            <option value="S">Sim</option>
                            <option value="N">Não</option>
                        </select>
                      </div>

                      <div class="col-12 text-end">
                        <button type="submit" id="btnSalvarPromocao" class="btn btn-success">Salvar promoção</button>
                      </div>
                    </form>
                  </td>
                </tr>
              <% }); %>
            <% } else { %>
              <tr>
                <td colspan="6" class="text-center text-muted py-4">Nenhum lote vence nos próximos 30 dias.</td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
  <div class="card card-soft mt-4">
  <div class="card-body">
    <h4 class="fw-bold text-success mb-3">Promoções cadastradas</h4>
    <div class="table-responsive">
      <table class="table align-middle mb-0">
       <thead>
  <tr>
    <th>Produto</th>
    <th>Descrição</th>
    <th>Lote</th>
    <th class="text-end">Desconto</th>
    <th class="text-end">Preço normal</th>
    <th class="text-end">Preço promo</th>
    <th class="text-end">Qtd.</th>
    <th>Período</th>
    <th>Status</th>
    <th class="text-end">Ação</th>
  </tr>
</thead>
<tbody>
  <% if (promocoes && promocoes.length > 0) { %>
    <% promocoes.forEach(function(p) { %>
      <tr>
        <td class="fw-semibold"><%= p.produto %></td>
        <td><%= p.descricao || '-' %></td>
        <td><%= p.id_lote %></td>
        <td class="text-end"><%= Number(p.percentual_desconto).toFixed(2) %>%</td>
        <td class="text-end">R$ <%= Number(p.preco).toFixed(2).replace('.', ',') %></td>
        <td class="text-end text-success fw-semibold">
          R$ <%= Number(p.itens_valor).toFixed(2).replace('.', ',') %>
        </td>
        <td class="text-end"><%= p.itens_qntd %></td>
        <td>
          <%= new Date(p.data_inicio).toLocaleDateString('pt-BR') %>
          até
          <%= new Date(p.data_fim).toLocaleDateString('pt-BR') %>
        </td>
        <td>
          <% if (p.ativa === 'S') { %>
            <span class="badge text-bg-success">Ativa</span>
          <% } else { %>
            <span class="badge text-bg-secondary">Inativa</span>
          <% } %>
        </td>
        <td class="text-end">
          <button type="button"
                  class="btn btn-sm btn-outline-success btn-editar-promocao"
                  data-id="<%= p.id_promocao %>"
                  data-descricao="<%= p.descricao || '' %>"
                  data-desconto="<%= Number(p.percentual_desconto).toFixed(2) %>"
                  data-ativo="<%= p.ativa %>"
                  data-bs-toggle="modal"
                  data-bs-target="#modalEditarPromocao">
            <i class="bi bi-pencil-square me-1"></i>Editar
          </button>
        </td>
      </tr>
    <% }); %>
  <% } else { %>
    <tr>
      <td colspan="10" class="text-center text-muted py-4">Nenhuma promoção cadastrada.</td>
    </tr>
  <% } %>
</tbody>
      </table>
    </div>
  </div>
</div>
<div class="modal fade" id="modalEditarPromocao" tabindex="-1" aria-labelledby="modalEditarPromocaoLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content" style="border-radius: 18px;">
      <form id="formEditarPromocao">
        <div class="modal-header">
          <h5 class="modal-title text-success fw-bold" id="modalEditarPromocaoLabel">Editar promoção</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
        </div>
        <div class="modal-body">
          <input type="hidden" id="edit_id_promocao" name="id_promocao">

          <div class="mb-3">
            <label for="edit_descricao" class="form-label">Descrição</label>
            <input value="" type="text" id="edit_descricao" name="descricao" class="form-control" maxlength="200">
          </div>

          <div class="mb-3">
            <label for="edit_percentual_desconto" class="form-label">Desconto (%)</label>
            <input value="" type="number" id="edit_percentual_desconto" name="percentual_desconto" class="form-control" min="1" max="99" step="0.01" required>
          </div>

          <div class="mb-3">
            <label for="edit_ativo" class="form-label">Ativa</label>
            <select id="edit_ativo" name="ativo" class="form-select" required>
              <option value="S">Sim</option>
              <option value="N">Não</option>
            </select>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
          <button type="submit" class="btn btn-success">Salvar alterações</button>
        </div>
      </form>
    </div>
  </div>
</div>
</main>

<footer class="bg-success text-white text-center py-3 mt-5">
  <p class="mb-2">GreenGo © 2026</p>
  <div class="footer-links-greengo">
    <a href="/clientes">Cliente</a>
    <a href="/fornecedores">Fornecedor</a>
    <a href="/gestao-produtos">Gestão</a>
    <a href="/">Início</a>
  </div>
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="js/validacao/promocao.js"></script>

</body>
</html>
