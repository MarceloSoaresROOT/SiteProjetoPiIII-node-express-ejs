<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>GreenGo - Gestão de Funcionários</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="style.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

  <style>
    body { background: #f6f8f5; }
    .gestao-hero { background: linear-gradient(135deg, #f4fff7, #ffffff); }
    .card-soft { border: 0; border-radius: 18px; box-shadow: 0 10px 26px rgba(20, 83, 45, 0.08); }
    .toolbar-gestao { background: #ffffff; border: 1px solid #e7efe8; border-radius: 18px; padding: 18px; }
    .btn-excluir-selecionados {
      border-radius: 999px;
      padding: 10px 18px;
      font-weight: 600;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      transition: .2s;
    }
    .btn-excluir-selecionados:disabled {
      opacity: .45;
      cursor: not-allowed;
    }
    .btn-editar-item,
    .btn-remover-produto {
      width: 38px;
      height: 38px;
      border-radius: 50%;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      transition: .2s;
    }
    .btn-editar-item {
      border: 1px solid #cfead8;
      background: #f4fff7;
      color: #198754;
    }
    .btn-editar-item:hover {
      background: #198754;
      color: #fff;
      transform: translateY(-1px);
      box-shadow: 0 8px 18px rgba(25, 135, 84, .22);
    }
    .btn-remover-produto {
      border: 1px solid #f2caca;
      background: #fff7f7;
      color: #dc3545;
    }
    .btn-remover-produto:hover {
      background: #dc3545;
      color: #fff;
      transform: translateY(-1px);
      box-shadow: 0 8px 18px rgba(220, 53, 69, .22);
    }
    .table thead th {
      background: #eaf7ee !important;
      color: #198754;
      border-bottom: 0;
    }
    .table tbody tr { transition: .15s; }
    .table tbody tr:hover { background: #fbfffc; }
    .badge-categoria {
      background: #eef9f1;
      color: #198754;
      border: 1px solid #cfead8;
      font-weight: 600;
    }
    .modal-content { border: 0; border-radius: 18px; }
    .modal-icon {
      width: 48px;
      height: 48px;
      border-radius: 50%;
      background: #fff1f1;
      color: #dc3545;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-size: 1.4rem;
    }
  </style>

</head>
<body>

<nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm">
  <div class="container">
    <a class="navbar-brand fw-bold text-success d-flex align-items-center" href="/">
      <img src="/imagens-produtos/imagens/img-site/logo-greengo.jpg" alt="Logo GreenGo" width="45" height="45" class="rounded me-2">
      GreenGo
    </a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menuGestao">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="menuGestao">
      <ul class="navbar-nav ms-auto">
        <li class="nav-item"><a class="nav-link" href="/">Início</a></li>
        <li class="nav-item"><a class="nav-link" href="/clientes">Cliente</a></li>
        <li class="nav-item"><a class="nav-link" href="/fornecedores">Fornecedor</a></li>
        <li class="nav-item"><a class="nav-link active" href="/gestao-produtos">Gestão</a></li>
      </ul>
    </div>
  </div>
</nav>

<header class="bg-white border-bottom py-4">
  <div class="container text-center">
    <h1 class="fw-bold text-success">Gestão de Funcionários</h1>
    <p class="text-muted mb-2">Cadastre, altere e exclua os funcionários da GreenGo.</p>
    <a href="/gestao-produtos" class="btn btn-sm btn-outline-success rounded-pill px-3">
      <i class="bi bi-arrow-left me-1"></i> Voltar para Gestão
    </a>
  </div>
</header>

<main class="container my-5">

  <div class="row g-3 mb-4">
    <div class="col-md-4">
      <div class="card h-100 card-soft card-resumo-gestao">
        <div class="card-body">
          <h5 class="card-title text-success"><i class="bi bi-person-badge me-1"></i>Total de funcionários</h5>
          <p class="card-text fs-4 fw-bold mb-0" id="totalFuncionarios">0</p>
        </div>
      </div>
    </div>
    <div class="col-md-4">
      <div class="card h-100 card-soft card-resumo-gestao">
        <div class="card-body">
          <h5 class="card-title text-success"><i class="bi bi-check2-circle me-1"></i>Ativos</h5>
          <p class="card-text fs-4 fw-bold mb-0" id="funcionariosAtivos">0</p>
        </div>
      </div>
    </div>
    <div class="col-md-4">
      <div class="card h-100 card-soft card-resumo-gestao">
        <div class="card-body">
          <h5 class="card-title text-success"><i class="bi bi-slash-circle me-1"></i>Inativos</h5>
          <p class="card-text fs-4 fw-bold mb-0" id="funcionariosInativos">0</p>
        </div>
      </div>
    </div>
  </div>

  <div class="card card-soft">
    <div class="card-header bg-white border-bottom py-3">
      <h2 class="h5 mb-0 text-success">Funcionários cadastrados</h2>
    </div>

    <div class="card-body">

      <div class="toolbar-gestao mb-4">
        <div class="toolbar-topo">
          <div class="toolbar-busca">
            <label for="buscaFuncionario" class="form-label fw-semibold">Buscar funcionário</label>
            <div class="input-group">
              <span class="input-group-text bg-white">
                <i class="bi bi-search text-success"></i>
              </span>
              <input type="text" class="form-control" id="buscaFuncionario" placeholder="Digite nome, CPF, matrícula ou cargo">
            </div>
          </div>

          <div class="toolbar-acoes">
            <button type="button" class="btn btn-success btn-adicionar-produto" id="btnAdicionar" data-bs-toggle="modal" data-bs-target="#modalAdicionar">
              <i class="bi bi-plus-circle"></i>
              Adicionar funcionário
            </button>

            <button class="btn btn-danger btn-excluir-selecionados" id="btnExcluirSelecionados" disabled>
              <i class="bi bi-trash3"></i>
              Excluir selecionados
              <span class="badge text-bg-light text-danger ms-1" id="qtdSelecionados">0</span>
            </button>
          </div>
        </div>
      </div>

      <div id="mensagemGestao" class="alert alert-success d-none" role="alert"></div>

      <div class="table-responsive">
        <table class="table table-hover align-middle">
          <thead>
            <tr>
              <th style="width: 45px;"><input type="checkbox" class="form-check-input" id="marcarTodos"></th>
              <th>Nome</th>
              <th>CPF</th>
              <th>Matrícula</th>
              <th>Cargo</th>
              <th>E-mail</th>
              <th>Telefone</th>
              <th>Admissão</th>
              <th>Status</th>
              <th class="text-center">Ação</th>
            </tr>
          </thead>
          <tbody id="corpoTabelaFuncionarios"></tbody>
        </table>
      </div>
    </div>
  </div>

</main>


<!-- Modal adicionar / editar (o mesmo modal serve para os dois) -->
<div class="modal fade" id="modalAdicionar" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable">
    <form id="formCadastroFuncionario" class="modal-content shadow" novalidate>
      <div class="modal-header border-0">
        <h5 class="modal-title text-success fw-bold" id="tituloModal">
          <i class="bi bi-plus-circle me-1"></i>
          <span id="textoTituloModal">Adicionar funcionário</span>
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
      </div>

      <div class="modal-body">
        <input type="hidden" id="idEdicao">
        <div class="row g-3">
          <input type="hidden" id="funTipoPessoa" value="PF">
          <div class="col-12">
            <h6 class="text-success fw-bold mb-0 mt-2">Dados de acesso e contato</h6>
          </div>
          <div class="col-md-6">
            <label for="funEmail" class="form-label">E-mail *</label>
            <input type="email" class="form-control" id="funEmail" placeholder="email@exemplo.com" maxlength="150" required>
            <div class="invalid-feedback">Informe um e-mail válido.</div>
          </div>
          <div class="col-md-6">
            <label for="funEmailConf" class="form-label">Confirmar e-mail *</label>
            <input type="email" class="form-control" id="funEmailConf" placeholder="Repita o e-mail" maxlength="150" required>
            <div class="invalid-feedback">Os e-mails precisam ser iguais.</div>
          </div>
          <div class="col-md-6">
            <label for="funSenha" class="form-label">Senha *</label>
            <input type="password" class="form-control" id="funSenha" placeholder="Mínimo de 6 caracteres" maxlength="255" minlength="6" autocomplete="new-password" required>
            <div class="invalid-feedback">A senha deve ter pelo menos 6 caracteres.</div>
            <div class="form-text">Ao editar, deixe em branco para manter a senha atual.</div>
          </div>
          <div class="col-md-6">
            <label for="funSenhaConf" class="form-label">Confirmar senha *</label>
            <input type="password" class="form-control" id="funSenhaConf" placeholder="Repita a senha" maxlength="255" autocomplete="new-password" required>
            <div class="invalid-feedback">As senhas precisam ser iguais.</div>
          </div>
          <div class="col-md-6">
            <label for="funTelefone" class="form-label">Telefone</label>
            <input type="text" class="form-control" id="funTelefone" placeholder="(18) 99999-9999" maxlength="15" onkeyup="mascara('(##) #####-####',this,event)">
            <div class="invalid-feedback">Telefone incompleto.</div>
          </div>
          <div class="col-md-6">
            <label for="funAtivo" class="form-label">Conta ativa *</label>
            <select class="form-select" id="funAtivo">
              <option value="S" selected>Sim</option>
              <option value="N">Não</option>
            </select>
          </div>
          <div class="col-12">
            <h6 class="text-success fw-bold mb-0 mt-2">Dados pessoais</h6>
          </div>
          <div class="col-md-8">
            <label for="funNome" class="form-label">Nome completo *</label>
            <input type="text" class="form-control" id="funNome" placeholder="Digite o nome completo" maxlength="150" minlength="3" required>
            <div class="invalid-feedback">Digite somente letras e pelo menos 3 caracteres.</div>
          </div>
          <div class="col-md-4">
            <label for="funCpf" class="form-label">CPF *</label>
            <input type="text" class="form-control" id="funCpf" placeholder="000.000.000-00" maxlength="14" required onkeyup="mascara('###.###.###-##',this,event)">
            <div class="invalid-feedback">Informe um CPF válido.</div>
          </div>
          <div class="col-md-4">
            <label for="funNascimento" class="form-label">Data de nascimento *</label>
            <input type="date" class="form-control" id="funNascimento" min="1920-01-01" max="2026-12-31" onblur="validarDataNascimentoFuncionario()" required>
            <div class="invalid-feedback" id="erroDataFun">Informe uma data entre 1920 e 2026.</div>
          </div>
          <div class="col-12">
            <h6 class="text-success fw-bold mb-0 mt-2">Dados do funcionário</h6>
          </div>
          <div class="col-md-4">
            <label for="funMatricula" class="form-label">Matrícula *</label>
            <input type="text" class="form-control" id="funMatricula" placeholder="Ex: FUNC-001" maxlength="30" required>
            <div class="invalid-feedback">Informe a matrícula (3 a 30 letras, números, ponto, hífen ou _).</div>
          </div>
          <div class="col-md-4">
            <label for="funCargo" class="form-label">Cargo</label>
            <input type="text" class="form-control" id="funCargo" placeholder="Ex: Atendente" maxlength="100">
            <div class="invalid-feedback">O cargo deve ter pelo menos 3 caracteres.</div>
          </div>
          <div class="col-md-4">
            <label for="funAdmissao" class="form-label">Data de admissão</label>
            <input type="date" class="form-control" id="funAdmissao" placeholder="">
            <div class="invalid-feedback">A data não pode ser futura.</div>
          </div>
          <div class="col-12">
            <h6 class="text-success fw-bold mb-0 mt-2">Endereço</h6>
          </div>
          <div class="col-md-3">
            <label for="funCep" class="form-label">CEP *</label>
            <input type="text" class="form-control" id="funCep" placeholder="00000-000" maxlength="9" required onkeyup="mascara('#####-###',this,event)">
            <div class="invalid-feedback">Informe o CEP completo.</div>
            <div class="form-text text-danger" id="erroCepFuncionario"></div>
          </div>
          <div class="col-md-6">
            <label for="funRua" class="form-label">Endereço *</label>
            <input type="text" class="form-control" id="funRua" placeholder="Ex: Rua das Palmeiras" maxlength="150" minlength="4" required>
            <div class="invalid-feedback">Informe o endereço.</div>
          </div>
          <div class="col-md-3">
            <label for="funNumero" class="form-label">Número *</label>
            <input type="number" class="form-control" id="funNumero" placeholder="Ex: 123" min="1" required>
            <div class="invalid-feedback">Informe um número válido.</div>
          </div>
          <div class="col-md-4">
            <label for="funBairro" class="form-label">Bairro *</label>
            <input type="text" class="form-control" id="funBairro" placeholder="Ex: Centro" maxlength="100" minlength="3" required>
            <div class="invalid-feedback">Informe o bairro.</div>
          </div>
          <div class="col-md-4">
            <label for="funCidade" class="form-label">Cidade *</label>
            <input type="text" class="form-control" id="funCidade" placeholder="Ex: Presidente Prudente" maxlength="100" minlength="3" required>
            <div class="invalid-feedback">Informe a cidade.</div>
          </div>
          <div class="col-md-2">
            <label for="funEstado" class="form-label">Estado *</label>
            <select class="form-select" id="funEstado" required><option value="">UF</option><option value="AC">AC</option><option value="AL">AL</option><option value="AP">AP</option><option value="AM">AM</option><option value="BA">BA</option><option value="CE">CE</option><option value="DF">DF</option><option value="ES">ES</option><option value="GO">GO</option><option value="MA">MA</option><option value="MT">MT</option><option value="MS">MS</option><option value="MG">MG</option><option value="PA">PA</option><option value="PB">PB</option><option value="PR">PR</option><option value="PE">PE</option><option value="PI">PI</option><option value="RJ">RJ</option><option value="RN">RN</option><option value="RS">RS</option><option value="RO">RO</option><option value="RR">RR</option><option value="SC">SC</option><option value="SP">SP</option><option value="SE">SE</option><option value="TO">TO</option></select>
            <div class="invalid-feedback">Selecione o estado.</div>
          </div>
          <div class="col-md-2">
            <label for="funComplemento" class="form-label">Complemento</label>
            <input type="text" class="form-control" id="funComplemento" placeholder="Ex: Apto 2" maxlength="100">
          </div>
          <div class="col-12">
            <div class="form-check form-switch">
              <input class="form-check-input" type="checkbox" role="switch" id="funPrincipal" checked>
              <label class="form-check-label" for="funPrincipal">Endereço principal</label>
            </div>
          </div>
        </div>

        <div class="alert alert-danger d-none mt-3 mb-0" id="erroAdicionarFuncionario">
          Preencha corretamente os campos obrigatórios.
        </div>
      </div>

      <div class="modal-footer border-0">
        <button type="button" class="btn btn-light border rounded-pill px-4" data-bs-dismiss="modal">
          Cancelar
        </button>
        <button type="submit" class="btn btn-success rounded-pill px-4" id="btnSalvarFuncionario">
          <i class="bi bi-check-circle me-1"></i>
          <span id="textoBtnSalvar">Adicionar</span>
        </button>
      </div>
    </form>
  </div>
</div>

<div class="modal fade" id="modalExcluir" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content shadow">
      <div class="modal-header border-0 pb-0">
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
      </div>

      <div class="modal-body text-center px-4">
        <div class="modal-icon mx-auto mb-3">
          <i class="bi bi-trash3"></i>
        </div>
        <h5 class="fw-bold mb-2">Confirmar exclusão</h5>
        <p class="text-muted mb-0" id="textoModalExcluir">Deseja realmente excluir?</p>
      </div>

      <div class="modal-footer border-0 justify-content-center pb-4">
        <button type="button" class="btn btn-light border rounded-pill px-4" data-bs-dismiss="modal">
          Cancelar
        </button>
        <button type="button" class="btn btn-danger rounded-pill px-4" id="confirmarExclusao">
          <i class="bi bi-check-circle me-1"></i> Confirmar
        </button>
      </div>
    </div>
  </div>
</div>



<footer class="bg-success text-white text-center py-3 mt-5">
  <p class="mb-2">GreenGo © 2026</p>
  <div class="footer-links-greengo">
    <a href="/clientes">Cliente</a>
    <a href="/fornecedor">Fornecedor</a>
    <a href="/gestao-produtos">Gestão</a>
    <a href="/">Início</a>
  </div>
</footer>



<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="js/validacao/validacoes.js"></script>
<script src="js/validacao/funcionario-validacao.js"></script>

</body>
</html>
