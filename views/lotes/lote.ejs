<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>GreenGo - Gestão de Lotes</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="style.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

  <style>
    body { background: #f6f8f5; }
    .gestao-hero { background: linear-gradient(135deg, #f4fff7, #ffffff); }
    .card-soft { border: 0; border-radius: 18px; box-shadow: 0 10px 26px rgba(20, 83, 45, 0.08); }
    .toolbar-gestao { background: #ffffff; border: 1px solid #e7efe8; border-radius: 18px; padding: 18px; }
    .btn-excluir-selecionados {
      border-radius: 999px;
      padding: 10px 18px;
      font-weight: 600;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      transition: .2s;
    }
    .btn-excluir-selecionados:disabled {
      opacity: .45;
      cursor: not-allowed;
    }
    .btn-editar-item,
    .btn-remover-produto {
      width: 38px;
      height: 38px;
      border-radius: 50%;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      transition: .2s;
    }
    .btn-editar-item {
      border: 1px solid #cfead8;
      background: #f4fff7;
      color: #198754;
    }
    .btn-editar-item:hover {
      background: #198754;
      color: #fff;
      transform: translateY(-1px);
      box-shadow: 0 8px 18px rgba(25, 135, 84, .22);
    }
    .btn-remover-produto {
      border: 1px solid #f2caca;
      background: #fff7f7;
      color: #dc3545;
    }
    .btn-remover-produto:hover {
      background: #dc3545;
      color: #fff;
      transform: translateY(-1px);
      box-shadow: 0 8px 18px rgba(220, 53, 69, .22);
    }
    .table thead th {
      background: #eaf7ee !important;
      color: #198754;
      border-bottom: 0;
    }
    .table tbody tr { transition: .15s; }
    .table tbody tr:hover { background: #fbfffc; }
    .badge-categoria {
      background: #eef9f1;
      color: #198754;
      border: 1px solid #cfead8;
      font-weight: 600;
    }
    .modal-content { border: 0; border-radius: 18px; }
    .modal-icon {
      width: 48px;
      height: 48px;
      border-radius: 50%;
      background: #fff1f1;
      color: #dc3545;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-size: 1.4rem;
    }
  </style>

</head>
<body>

<nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm">
  <div class="container">
    <a class="navbar-brand fw-bold text-success d-flex align-items-center" href="/">
      <img src="/imagens-produtos/imagens/img-site/logo-greengo.jpg" alt="Logo GreenGo" width="45" height="45" class="rounded me-2">
      GreenGo
    </a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menuGestao">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="menuGestao">
      <ul class="navbar-nav ms-auto">
        <li class="nav-item"><a class="nav-link" href="/">Início</a></li>
        <li class="nav-item"><a class="nav-link" href="/clientes">Cliente</a></li>
        <li class="nav-item"><a class="nav-link" href="/fornecedores">Fornecedor</a></li>
        <li class="nav-item"><a class="nav-link active" href="/gestao-produtos">Gestão</a></li>
      </ul>
    </div>
  </div>
</nav>

<header class="bg-white border-bottom py-4">
  <div class="container text-center">
    <h1 class="fw-bold text-success">Gestão de Lotes</h1>
    <p class="text-muted mb-2">Controle os lotes, validades e quantidades de cada produto.</p>
    <a href="/gestao-produtos" class="btn btn-sm btn-outline-success rounded-pill px-3">
      <i class="bi bi-arrow-left me-1"></i> Voltar para Gestão
    </a>
  </div>
</header>

<main class="container my-5">

  <div class="row g-3 mb-4">
    <div class="col-md-4">
      <div class="card h-100 card-soft card-resumo-gestao">
        <div class="card-body">
          <h5 class="card-title text-success"><i class="bi bi-boxes me-1"></i>Total de lotes</h5>
          <p class="card-text fs-4 fw-bold mb-0" id="totalLotes">0</p>
        </div>
      </div>
    </div>
    <div class="col-md-4">
      <div class="card h-100 card-soft card-resumo-gestao">
        <div class="card-body">
          <h5 class="card-title text-success"><i class="bi bi-hourglass-split me-1"></i>Próximos do vencimento</h5>
          <p class="card-text fs-4 fw-bold mb-0" id="lotesProximosVencimento">0</p>
        </div>
      </div>
    </div>
    <div class="col-md-4">
      <div class="card h-100 card-soft card-resumo-gestao">
        <div class="card-body">
          <h5 class="card-title text-success"><i class="bi bi-x-octagon me-1"></i>Vencidos</h5>
          <p class="card-text fs-4 fw-bold mb-0" id="lotesVencidos">0</p>
        </div>
      </div>
    </div>
  </div>

  <div class="card card-soft">
    <div class="card-header bg-white border-bottom py-3">
      <h2 class="h5 mb-0 text-success">Lotes cadastrados</h2>
    </div>

    <div class="card-body">

      <div class="toolbar-gestao mb-4">
        <div class="toolbar-topo">
          <div class="toolbar-busca">
            <label for="buscaLote" class="form-label fw-semibold">Buscar lote</label>
            <div class="input-group">
              <span class="input-group-text bg-white">
                <i class="bi bi-search text-success"></i>
              </span>
              <input type="text" class="form-control" id="buscaLote" placeholder="Digite produto ou número do lote">
            </div>
          </div>

          <div class="toolbar-acoes">
            <button type="button" class="btn btn-success btn-adicionar-produto" id="btnAdicionar" data-bs-toggle="modal" data-bs-target="#modalAdicionar">
              <i class="bi bi-plus-circle"></i>
              Adicionar lote
            </button>

            <button class="btn btn-danger btn-excluir-selecionados" id="btnExcluirSelecionados" disabled>
              <i class="bi bi-trash3"></i>
              Excluir selecionados
              <span class="badge text-bg-light text-danger ms-1" id="qtdSelecionados">0</span>
            </button>
          </div>
        </div>
      </div>

      <div id="mensagemGestao" class="alert alert-success d-none" role="alert"></div>

      <div class="table-responsive">
        <table class="table table-hover align-middle">
          <thead>
            <tr>
              <th style="width: 45px;"><input type="checkbox" class="form-check-input" id="marcarTodos"></th>
              <th>Produto</th>
              <th>Lote</th>
              <th>Validade</th>
              <th>Quantidade</th>
              <th>Situação</th>
              <th class="text-center">Ação</th>
            </tr>
          </thead>
          <tbody id="corpoTabelaLotes"></tbody>
        </table>
      </div>
    </div>
  </div>

</main>


<!-- Modal adicionar / editar (o mesmo modal serve para os dois) -->
<div class="modal fade" id="modalAdicionar" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-lg">
    <div class="modal-content shadow">
      <div class="modal-header border-0">
        <h5 class="modal-title text-success fw-bold" id="tituloModal">
          <i class="bi bi-plus-circle me-1"></i>
          <span id="textoTituloModal">Adicionar lote</span>
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
      </div>

      <div class="modal-body">
        <input type="hidden" id="idEdicao">
        <div class="row g-3">
          <div class="col-md-12">
            <label for="novoProduto" class="form-label">Produto *</label>
            <select class="form-select" id="novoProduto"><option value="">Carregando...</option></select>
            <div class="invalid-feedback">Selecione o produto.</div>
            <div class="form-text">Não encontrou? <a href="/produtos">Cadastrar produto</a></div>
          </div>
          <div class="col-md-4">
            <label for="novoNumeroLote" class="form-label">Número do lote *</label>
            <input type="text" class="form-control" id="novoNumeroLote" placeholder="Ex: L2026-001" maxlength="50">
            <div class="invalid-feedback">Informe o número do lote.</div>
          </div>
          <div class="col-md-4">
            <label for="novaValidade" class="form-label">Validade *</label>
            <input type="date" class="form-control" id="novaValidade" placeholder="">
            <div class="invalid-feedback">Informe a validade.</div>
          </div>
          <div class="col-md-4">
            <label for="novaQuantidade" class="form-label">Quantidade inicial *</label>
            <input type="number" class="form-control" id="novaQuantidade" placeholder="Ex: 20" min="1" step="1">
            <div class="invalid-feedback">Informe uma quantidade maior que zero.</div>
          </div>
          <div class="col-12">
            <p class="text-muted small mb-0" id="avisoQuantidade">
              <i class="bi bi-info-circle me-1"></i>
              Depois de criado, o estoque do lote só muda por movimentação.
            </p>
          </div>
        </div>

        <div class="alert alert-danger d-none mt-3 mb-0" id="erroAdicionarLote">
          Preencha corretamente os campos obrigatórios.
        </div>
      </div>

      <div class="modal-footer border-0">
        <button type="button" class="btn btn-light border rounded-pill px-4" data-bs-dismiss="modal">
          Cancelar
        </button>
        <button type="button" class="btn btn-success rounded-pill px-4" id="btnSalvarLote">
          <i class="bi bi-check-circle me-1"></i>
          <span id="textoBtnSalvar">Adicionar</span>
        </button>
      </div>
    </div>
  </div>
</div>

<div class="modal fade" id="modalExcluir" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content shadow">
      <div class="modal-header border-0 pb-0">
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
      </div>

      <div class="modal-body text-center px-4">
        <div class="modal-icon mx-auto mb-3">
          <i class="bi bi-trash3"></i>
        </div>
        <h5 class="fw-bold mb-2">Confirmar exclusão</h5>
        <p class="text-muted mb-0" id="textoModalExcluir">Deseja realmente excluir?</p>
      </div>

      <div class="modal-footer border-0 justify-content-center pb-4">
        <button type="button" class="btn btn-light border rounded-pill px-4" data-bs-dismiss="modal">
          Cancelar
        </button>
        <button type="button" class="btn btn-danger rounded-pill px-4" id="confirmarExclusao">
          <i class="bi bi-check-circle me-1"></i> Confirmar
        </button>
      </div>
    </div>
  </div>
</div>



<footer class="bg-success text-white text-center py-3 mt-5">
  <p class="mb-2">GreenGo © 2026</p>
  <div class="footer-links-greengo">
    <a href="/clientes">Cliente</a>
    <a href="/fornecedor">Fornecedor</a>
    <a href="/gestao-produtos">Gestão</a>
    <a href="/">Início</a>
  </div>
</footer>



<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<!-- <script src="js/validacao/gestao-lotes.js"></script> -->

</body>
</html>
