<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>GreenGo - Gestão de Produtos</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="style.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

  <style>
    body { background: #f6f8f5; }
    .gestao-hero { background: linear-gradient(135deg, #f4fff7, #ffffff); }
    .card-soft { border: 0; border-radius: 18px; box-shadow: 0 10px 26px rgba(20, 83, 45, 0.08); }
    .toolbar-gestao { background: #ffffff; border: 1px solid #e7efe8; border-radius: 18px; padding: 18px; }
    .btn-excluir-selecionados {
      border-radius: 999px;
      padding: 10px 18px;
      font-weight: 600;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      transition: .2s;
    }
    .btn-excluir-selecionados:disabled {
      opacity: .45;
      cursor: not-allowed;
    }
    .btn-remover-produto {
      width: 38px;
      height: 38px;
      border-radius: 50%;
      border: 1px solid #f2caca;
      background: #fff7f7;
      color: #dc3545;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      transition: .2s;
    }
    .btn-remover-produto:hover {
      background: #dc3545;
      color: #fff;
      transform: translateY(-1px);
      box-shadow: 0 8px 18px rgba(220, 53, 69, .22);
    }
    .table thead th {
      background: #eaf7ee !important;
      color: #198754;
      border-bottom: 0;
    }
    .table tbody tr { transition: .15s; }
    .table tbody tr:hover { background: #fbfffc; }
    .badge-categoria {
      background: #eef9f1;
      color: #198754;
      border: 1px solid #cfead8;
      font-weight: 600;
    }
    .modal-content { border: 0; border-radius: 18px; }
    .modal-icon {
      width: 48px;
      height: 48px;
      border-radius: 50%;
      background: #fff1f1;
      color: #dc3545;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-size: 1.4rem;
    }
  </style>

</head>
<body>

<nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm">
  <div class="container">
    <a class="navbar-brand fw-bold text-success d-flex align-items-center" href="/index">
      <img src="/imagens-produtos/imagens/img-site/logo-greengo.jpg" alt="Logo GreenGo" width="45" height="45" class="rounded me-2">
      GreenGo
    </a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menuGestao">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="menuGestao">
      <ul class="navbar-nav ms-auto">
        <li class="nav-item"><a class="nav-link" href="/index">Início</a></li>
        <li class="nav-item"><a class="nav-link" href="/cadastro-clientes">Cliente</a></li>
        <li class="nav-item"><a class="nav-link" href="/cadastro-fornecedores">Fornecedor</a></li>
        <li class="nav-item"><a class="nav-link" href="/gestao-produtos">Gestão</a></li>
      </ul>
    </div>
  </div>
</nav>

<header class="bg-white border-bottom py-4">
  <div class="container text-center">
    <h1 class="fw-bold text-success">Gestão de Produtos</h1>
    <p class="text-muted mb-0">Controle os produtos cadastrados na GreenGo. </p>
  </div>
</header>

<main class="container my-5">

  <section class="row g-3 mb-4 atalhos-cadastros-gestao">
    <div class="col-md-6">
      <a href="/cadastro-clientes" class="text-decoration-none">
        <div class="card h-100 card-soft card-resumo-gestao">
          <div class="card-body">
            <h5 class="card-title text-success">
              <i class="bi bi-person-plus me-1"></i>
              Cadastro de clientes
            </h5>
            <p class="card-text text-muted mb-0">
              Abrir formulário de cadastro de clientes.
            </p>
          </div>
        </div>
      </a>
    </div>

    <div class="col-md-6">
      <a href="/cadastro-fornecedores" class="text-decoration-none">
        <div class="card h-100 card-soft card-resumo-gestao">
          <div class="card-body">
            <h5 class="card-title text-success">
              <i class="bi bi-truck me-1"></i>
              Cadastro de fornecedores
            </h5>
            <p class="card-text text-muted mb-0">
              Abrir formulário de cadastro de fornecedores.
            </p>
          </div>
        </div>
      </a>
    </div>
  </section>


  <div class="row g-3 mb-4">
    <div class="col-md-4">
      <div class="card h-100 card-soft card-resumo-gestao">
        <div class="card-body">
          <h5 class="card-title text-success"><i class="bi bi-basket2 me-1"></i>Frutas</h5>
          <p class="card-text fs-4 fw-bold mb-0" id="totalFrutas">0</p>
        </div>
      </div>
    </div>
    <div class="col-md-4">
      <div class="card h-100 card-soft card-resumo-gestao">
        <div class="card-body">
          <h5 class="card-title text-success"><i class="bi bi-flower1 me-1"></i>Legumes</h5>
          <p class="card-text fs-4 fw-bold mb-0" id="totalLegumes">0</p>
        </div>
      </div>
    </div>
    <div class="col-md-4">
      <div class="card h-100 card-soft card-resumo-gestao">
        <div class="card-body">
          <h5 class="card-title text-success"><i class="bi bi-leaf me-1"></i>Verduras</h5>
          <p class="card-text fs-4 fw-bold mb-0" id="totalVerduras">0</p>
        </div>
      </div>
    </div>
  </div>

  <div class="card card-soft">
    <div class="card-header bg-white border-bottom py-3">
      <h2 class="h5 mb-0 text-success">Produtos cadastrados</h2>
    </div>

    <div class="card-body">
      
      <div class="toolbar-gestao mb-4">
        <div class="toolbar-topo">
          <div class="toolbar-busca">
            <label for="buscaProduto" class="form-label fw-semibold">Buscar produto</label>
            <div class="input-group">
              <span class="input-group-text bg-white">
                <i class="bi bi-search text-success"></i>
              </span>
              <input type="text" class="form-control" id="buscaProduto" placeholder="Digite nome, categoria ou fornecedor">
            </div>
          </div>

          <div class="toolbar-acoes">
            <button type="button" class="btn btn-success btn-adicionar-produto" data-bs-toggle="modal" data-bs-target="#modalAdicionar">
              <i class="bi bi-plus-circle"></i>
              Adicionar produto
            </button>

            <button class="btn btn-danger btn-excluir-selecionados" id="btnExcluirSelecionados" disabled>
              <i class="bi bi-trash3"></i>
              Excluir selecionados
              <span class="badge text-bg-light text-danger ms-1" id="qtdSelecionados">0</span>
            </button>
          </div>
        </div>
      </div>

      <div id="mensagemGestao" class="alert alert-success d-none" role="alert"></div>

      <div class="table-responsive">
        <table class="table table-hover align-middle">
          <thead>
            <tr>
              <th style="width: 45px;"><input type="checkbox" class="form-check-input" id="marcarTodos"></th>
              <th>Produto</th>
              <th>Categoria</th>
              <th>Preço</th>
              <th>Estoque</th>
              <th>Fornecedor</th>
              <th class="text-center">Ação</th>
            </tr>
          </thead>
          <tbody id="corpoTabelaProdutos"></tbody>
        </table>
      </div>
    </div>
  </div>

</main>


<div class="modal fade" id="modalAdicionar" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-lg">
    <div class="modal-content shadow">
      <div class="modal-header border-0">
        <h5 class="modal-title text-success fw-bold">
          <i class="bi bi-plus-circle me-1"></i>
          Adicionar produto
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
      </div>

      <div class="modal-body">
        <div class="row g-3">
          <div class="col-md-6">
            <label for="novoNome" class="form-label">Produto *</label>
            <input type="text" class="form-control" id="novoNome" placeholder="Ex: Abacaxi">
            <div class="invalid-feedback">Informe o nome do produto.</div>
          </div>

          <div class="col-md-6">
            <label for="novaCategoria" class="form-label">Categoria *</label>
            <select class="form-select" id="novaCategoria">
              <option value="">Selecione</option>
              <option value="Frutas">Frutas</option>
              <option value="Legumes">Legumes</option>
              <option value="Verduras">Verduras</option>
            </select>
            <div class="invalid-feedback">Selecione a categoria.</div>
          </div>

          <div class="col-md-4">
            <label for="novoPreco" class="form-label">Preço *</label>
            <input type="number" class="form-control" id="novoPreco" placeholder="Ex: 4.99" min="0.01" step="0.01">
            <div class="invalid-feedback">Informe um preço maior que zero.</div>
          </div>

          <div class="col-md-4">
            <label for="novoEstoque" class="form-label">Estoque *</label>
            <input type="number" class="form-control" id="novoEstoque" placeholder="Ex: 20" min="1">
            <div class="invalid-feedback">Informe estoque maior que zero.</div>
          </div>

          <div class="col-md-4">
            <label for="novoFornecedor" class="form-label">Fornecedor *</label>
            <input type="text" class="form-control" id="novoFornecedor" placeholder="Ex: Sítio Verde">
            <div class="invalid-feedback">Informe o fornecedor.</div>
          </div>
        </div>

        <div class="alert alert-danger d-none mt-3 mb-0" id="erroAdicionarProduto">
          Preencha corretamente os campos obrigatórios.
        </div>
      </div>

      <div class="modal-footer border-0">
        <button type="button" class="btn btn-light border rounded-pill px-4" data-bs-dismiss="modal">
          Cancelar
        </button>
        <button type="button" class="btn btn-success rounded-pill px-4" id="btnSalvarProduto">
          <i class="bi bi-check-circle me-1"></i>
          Adicionar
        </button>
      </div>
    </div>
  </div>
</div>

<div class="modal fade" id="modalExcluir" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content shadow">
      <div class="modal-header border-0 pb-0">
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
      </div>

      <div class="modal-body text-center px-4">
        <div class="modal-icon mx-auto mb-3">
          <i class="bi bi-trash3"></i>
        </div>
        <h5 class="fw-bold mb-2">Confirmar exclusão</h5>
        <p class="text-muted mb-0" id="textoModalExcluir">Deseja realmente excluir?</p>
      </div>

      <div class="modal-footer border-0 justify-content-center pb-4">
        <button type="button" class="btn btn-light border rounded-pill px-4" data-bs-dismiss="modal">
          Cancelar
        </button>
        <button type="button" class="btn btn-danger rounded-pill px-4" id="confirmarExclusao">
          <i class="bi bi-check-circle me-1"></i> Confirmar
        </button>
      </div>
    </div>
  </div>
</div>



<footer class="bg-success text-white text-center py-3 mt-5">
  <p class="mb-2">GreenGo © 2026</p>
  <div class="footer-links-greengo">
    <a href="/cadastro-clientes">Cliente</a>
    <a href="/cadastro-fornecedores">Fornecedor</a>
    <a href="/gestao-produtos">Gestão</a>
    <a href="/index">Início</a>
  </div>
</footer>



<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="gestao.js"></script>

</body>
</html>
